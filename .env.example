# Environment Configuration for HOMELY

# Gemini API Key for Ask Homely AI assistant
GEMINI_API_KEY=

# 32-byte (or passphrase) key for AES-256-GCM Family Vault encryption at rest
# If not provided, a deterministic persistent local key will be derived safely.
VAULT_ENCRYPTION_KEY=

# Web Push / VAPID Keys for device push notifications (Android / PWA / Browser)
# Generate with: npx web-push generate-vapid-keys
# If omitted, Homely will auto-generate and persist keys locally for seamless local development
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@homely.app
